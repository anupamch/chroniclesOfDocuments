# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=llama3.2-vision

# Model Provider: "local" for Ollama, "api" for HuggingFace
MODEL_PROVIDER=local

# HuggingFace Configuration (used when MODEL_PROVIDER=api)
HF_ACCESS_TOKEN=your_huggingface_token_here
HF_MODEL_NAME=meta-llama/Llama-3.2-1B-Instruct

# Document Processing
INPUT_FOLDER=./documents
OUTPUT_FOLDER=./output

# OCR Method: "tesseract" or "vision"
# tesseract: Requires Tesseract installed at OS level (faster, more accurate)
# vision: Uses Ollama vision models (no OS install needed, slower)
OCR_METHOD=vision

# GPU Settings (for better performance on RTX 5050)
OLLAMA_NUM_GPU=1
OLLAMA_GPU_LAYERS=33  # Use GPU acceleration
